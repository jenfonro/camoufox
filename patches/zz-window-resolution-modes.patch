+/* static */
+void ChromeUtils::CamouGetWindowMode(GlobalObject& aGlobal, nsAString& aResult) {
+  aResult.AssignASCII(MaskConfig::GetWindowResolution().ModeName());
+}
+
+/* static */
+double ChromeUtils::CamouGetWindowDimension(GlobalObject& aGlobal,
+                                           const nsAString& aName) {
+  NS_ConvertUTF16toUTF8 name(aName);
+  return MaskConfig::GetWindowResolution().GlobalNumber(name.get()).value_or(0);
+}
+
+/* static */
+void ChromeUtils::CamouGetNativeViewportSize(GlobalObject& aGlobal,
+                                            WindowProxyHolder& aWindow,
+                                            nsTArray<double>& aResult) {
+  // Automation must wait for the rendered viewport, not portrait DOM getters.
+  nsIDocShell* docShell = aWindow.get()->GetDocShell();
+  PresShell* shell = docShell ? docShell->GetPresShell() : nullptr;
+  nsPresContext* context = shell ? shell->GetPresContext() : nullptr;
+  const nsSize size = context ? context->GetVisibleArea().Size() : nsSize();
+  aResult.AppendElement(CSSPixel::FromAppUnits(size.width));
+  aResult.AppendElement(CSSPixel::FromAppUnits(size.height));
+}
+
