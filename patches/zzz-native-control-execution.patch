 /* static */
+void ChromeUtils::CamouEvaluateInPage(GlobalObject& aGlobal,
+                                    WindowProxyHolder& aWindow,
+                                    const nsAString& aExpression,
+                                    JS::MutableHandle<JS::Value> aResult,
+                                    ErrorResult& aRv) {
+  nsPIDOMWindowOuter* outer = aWindow.get()->GetDOMWindow();
+  RefPtr<nsGlobalWindowInner> inner =
+      outer ? nsGlobalWindowInner::Cast(outer->GetCurrentInnerWindow()) : nullptr;
+  if (!inner || !inner->GetExtantDoc() || !inner->GetGlobalJSObject()) {
+    aRv.ThrowInvalidStateError("The page document is no longer available");
+    return;
+  }
+  if (inner->GetExtantDoc()->NodePrincipal()->IsSystemPrincipal()) {
+    aRv.ThrowSecurityError("Page execution does not accept privileged documents");
+    return;
+  }
+
+  // This is a chrome-only embedder operation in the document's own realm. It
+  // does not call a page-replaceable eval function, attach a Debugger, or alter
+  // the document's CSP. Scripts subsequently run by the page retain normal CSP
+  // and content-principal checks.
+  JSContext* cx = aGlobal.Context();
+  JS::Rooted<JS::Value> result(cx);
+  {
+    JSAutoRealm realm(cx, inner->GetGlobalJSObject());
+    JS::CompileOptions options(cx);
+    options.setFileAndLine("camoufox-control", 1);
+    JS::SourceText<char16_t> text;
+    if (!text.init(cx, aExpression.BeginReading(), aExpression.Length(),
+                   JS::SourceOwnership::Borrowed) ||
+        !JS::Evaluate(cx, options, text, &result)) {
+      aRv.NoteJSContextException(cx);
+      return;
+    }
+  }
+  if (!JS_WrapValue(cx, &result)) {
+    aRv.NoteJSContextException(cx);
+    return;
+  }
+  aResult.set(result);
+}
