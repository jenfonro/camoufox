+// Process-wide WGSL policy is consumed by the parser, not just API getters.
+extern uint32_t wgpu_parent_graphics_wgsl_mask() {
+  const auto& gpu = MaskConfig::GetGraphicsConfig().GPU();
+  if (!gpu.contains("wgslLanguageFeatures")) return UINT32_MAX;
+  uint32_t mask = 0;
+  for (const auto& feature : gpu["wgslLanguageFeatures"]) {
+    if (feature == "readonly_and_readwrite_storage_textures") mask |= 1;
+    if (feature == "packed_4x8_integer_dot_product") mask |= 2;
+    if (feature == "pointer_composite_access") mask |= 4;
+  }
+  return mask;
+}
