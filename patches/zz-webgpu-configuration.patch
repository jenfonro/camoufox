+bool Adapter::ApplyProfile(
+    std::shared_ptr<const camoufox::AdapterProfile> profile) {
+  if (!profile || profile->values.empty()) return true;
+  const auto& values = profile->values;
+  const auto fail = [](const std::string& reason) {
+    printf_stderr("ERROR: Camoufox WebGPU profile: %s\n", reason.c_str());
+    return false;
+  };
+
+  if (values.contains("info")) {
+    const auto& info = values["info"];
+    if (profile->forceFallbackAdapter && info.contains("isFallbackAdapter") &&
+        !info["isFallbackAdapter"].get<bool>())
+      return fail("forceFallbackAdapter request requires isFallbackAdapter=true");
+    // Firefox 152 does not implement the subgroups feature. Preserve its
+    // defined 4/128 fallback instead of claiming unimplemented subgroup sizes.
+    if (info.contains("subgroupMinSize") && info["subgroupMinSize"] != 4)
+      return fail("subgroupMinSize must be 4 without implemented subgroups");
+    if (info.contains("subgroupMaxSize") && info["subgroupMaxSize"] != 128)
+      return fail("subgroupMaxSize must be 128 without implemented subgroups");
+  }
+
+  RefPtr<SupportedFeatures> features = mFeatures;
+  if (values.contains("features")) {
+    features = new SupportedFeatures(this);
+    IgnoredErrorResult rv;
+    for (const auto& entry : values["features"]) {
+      const auto name = entry.get<std::string>();
+      bool found = false;
+      for (const auto feature : dom::MakeWebIDLEnumeratedRange<dom::GPUFeatureName>()) {
+        if (dom::GetEnumString(feature).Equals(name.c_str())) {
+          if (!mFeatures->Features().count(feature))
+            return fail("feature is not executable on this adapter: " + name);
+          features->Add(feature, rv);
+          found = true;
+          break;
+        }
+      }
+      if (!found) return fail("unknown feature: " + name);
+    }
+    const auto& set = features->Features();
+    if (!set.count(dom::GPUFeatureName::Core_features_and_limits))
+      return fail("features must include core-features-and-limits");
+    if (set.count(dom::GPUFeatureName::Texture_compression_bc_sliced_3d) &&
+        !set.count(dom::GPUFeatureName::Texture_compression_bc))
+      return fail("texture-compression-bc-sliced-3d requires texture-compression-bc");
+    if (set.count(dom::GPUFeatureName::Texture_compression_astc_sliced_3d) &&
+        !set.count(dom::GPUFeatureName::Texture_compression_astc))
+      return fail("texture-compression-astc-sliced-3d requires texture-compression-astc");
+  }
+
+  auto effective = *mLimits->mFfi;
+  if (values.contains("limits")) {
+    ffi::WGPULimits defaults = {};
+    ffi::wgpu_client_fill_default_limits(&defaults);
+    const auto& configured = values["limits"];
+    for (const auto limit : MakeInclusiveEnumeratedRange(Limit::_LAST)) {
+      const std::string key(ToJsKey(limit));
+      if (!configured.contains(key)) continue;
+      const auto value = configured[key].get<uint64_t>();
+      const auto supported = GetLimit(mInfoInner->limits, limit);
+      const auto baseline = GetLimit(defaults, limit);
+      if (key.rfind("max", 0) == 0) {
+        if (value > supported || value < baseline)
+          return fail(key + " must be between the core default and backend capacity");
+      } else {
+        if (value < supported || value > baseline || !std::has_single_bit(value))
+          return fail(key + " must be a supported power-of-two alignment");
+      }
+      SetLimit(&effective, limit, value);
+    }
+    // These fields are aliases in Firefox 152 / its wgpu Limits structure.
+    // Validate the shared constraint instead of exposing unenforceable values.
+    for (const auto limit : {Limit::MaxStorageBuffersInVertexStage,
+                             Limit::MaxStorageBuffersInFragmentStage,
+                             Limit::MaxStorageTexturesInVertexStage,
+                             Limit::MaxStorageTexturesInFragmentStage}) {
+      const std::string key(ToJsKey(limit));
+      if (configured.contains(key) && configured[key].get<uint64_t>() != GetLimit(effective, limit))
+        return fail(key + " must equal its PerShaderStage limit in Firefox 152");
+    }
+    if (effective.max_uniform_buffer_binding_size > effective.max_buffer_size ||
+        effective.max_storage_buffer_binding_size > effective.max_buffer_size)
+      return fail("buffer binding sizes must not exceed maxBufferSize");
+  }
+
+  mFeatures = std::move(features);
+  *mLimits->mFfi = effective;
+  mProfile = std::move(profile);
+  return true;
+}
